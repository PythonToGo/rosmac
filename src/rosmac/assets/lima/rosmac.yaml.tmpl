# rosmac Lima VM — ARM64 Ubuntu 22.04 (Jammy), ROS2 Humble Tier 1
# 이 파일은 템플릿이다. rosmac이 앳(delimiter) 플레이스홀더를 config로 치환해
# ~/.rosmac/lima/rosmac.yaml 로 쓴다.
# 원형: Phase 0.2에서 무인 재현 검증된 ~/rosmac_spike/lima-rosmac.yaml (phase0-results.md)
images:
  - location: "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-arm64.img"
    arch: "aarch64"
cpus: @cpus
memory: "@memory"
disk: "@disk"
portForwards:
  # KI-27: lima는 게스트가 listen하는 포트를 자동 포워딩한다. VM DDS의 UDP 74xx가
  # 맥 127.0.0.1에 포워딩되면 맥 로컬 DDS의 SPDP 유니캐스트 핑을 삼켜 저인덱스
  # 참가자(브리지 등)가 디스커버리 불능이 된다 (VM 참가자 수에 따라 간헐 발현).
  # rosmac 경계는 TCP(zenoh 7447, foxglove 8765)뿐 — UDP 포워딩은 전면 차단.
  - guestPortRange: [1, 65535]
    proto: udp
    ignore: true
  - guestIP: "0.0.0.0"        # 게스트가 0.0.0.0에 bind한 UDP도 차단 (실측: 규칙 2개 다 필요)
    guestPortRange: [1, 65535]
    proto: udp
    ignore: true
  - guestPort: @bridge_port   # zenoh
    hostPort: @bridge_port
  - guestPort: @foxglove_port   # foxglove_bridge (Phase 2)
    hostPort: @foxglove_port
provision:
  - mode: system
    script: |
@provision_ros
  - mode: system
    script: |
@provision_bridge
  - mode: system
    script: |
@provision_foxglove
